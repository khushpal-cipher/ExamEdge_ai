# Names only. Copy to .env.local and fill locally; never commit values.
# Local Supabase values come from `supabase status -o env`.

# Web (public values only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Worker (worker role, RLS applies). Also needs the two NEXT_PUBLIC_* values above.
WORKER_DATABASE_URL=
# Storage service account (non-privileged Supabase Auth user, reads only queued/processing files)
WORKER_STORAGE_EMAIL=
WORKER_STORAGE_PASSWORD=

# Deployment metadata
COMMIT_SHA=

# AI providers: fake (default) | anthropic | gemini (test only, ADR-051) / voyage
AI_PROVIDER=
EMBEDDINGS_PROVIDER=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
VOYAGE_API_KEY=

# Development-only demo sign-in (refused unless Supabase URL is localhost)
DEMO_LOGIN_ENABLED=

# Ops scripts ONLY (scripts/*). Never set in web or worker runtime.
SUPABASE_SECRET_KEY=

# Google sign-in (read by `supabase start` from this repo's root .env; Google Cloud OAuth client, ADR-035)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Invitation emails (web Server Functions; Resend, ADR-035). EMAIL_FROM defaults to Resend's test sender.
RESEND_API_KEY=
EMAIL_FROM=

# Billing (web Server Functions): the founder's UPI id shown to owners, and where "payment to check" emails go.
UPI_ID=
PAYMENTS_ALERT_EMAIL=
