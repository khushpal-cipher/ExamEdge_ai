# Names only. Copy to .env.local and fill locally; never commit values.
# Local Supabase values come from `supabase status -o env`.

# Web (public values only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Worker (worker role, RLS applies)
WORKER_DATABASE_URL=

# Deployment metadata
COMMIT_SHA=

# AI providers: fake (default) | anthropic / voyage
AI_PROVIDER=
EMBEDDINGS_PROVIDER=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Development-only demo sign-in (refused unless Supabase URL is localhost)
DEMO_LOGIN_ENABLED=

# Ops scripts ONLY (scripts/*). Never set in web or worker runtime.
SUPABASE_SECRET_KEY=
